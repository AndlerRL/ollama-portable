# Ollama Portable Configuration
# Copy to .env and customize

# Host port for Ollama API
OLLAMA_HOST_PORT=11434

# Host port for Open WebUI (set to 0 to disable)
WEBUI_HOST_PORT=3000

# Storage path for models (leave empty for Docker volume)
# OLLAMA_STORAGE_PATH=./ollama_data

# Enable GPU acceleration (auto-detected if empty)
# OLLAMA_GPU=true
